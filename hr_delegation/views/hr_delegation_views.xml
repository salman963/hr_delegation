<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List view ─────────────────────────────────────────────────── -->
    <record id="view_hr_delegation_list" model="ir.ui.view">
        <field name="name">hr.delegation.list</field>
        <field name="model">hr.delegation</field>
        <field name="arch" type="xml">
            <tree string="Delegations" decoration-success="state == 'active'"
                  decoration-muted="state in ('done', 'cancelled')"
                  decoration-warning="state == 'pending'">
                <field name="delegator_id"/>
                <field name="delegatee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="leave_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'pending'"
                       decoration-info="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- ── Form view ─────────────────────────────────────────────────── -->
    <record id="view_hr_delegation_form" model="ir.ui.view">
        <field name="name">hr.delegation.form</field>
        <field name="model">hr.delegation</field>
        <field name="arch" type="xml">
            <form string="Manager Delegation">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_deactivate" string="End Delegation"
                            type="object" class="btn-secondary"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object" class="btn-secondary"
                            invisible="state not in ('pending', 'active')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,active,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="delegator_id" placeholder="Delegating Manager"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Delegation">
                            <field name="delegator_id" readonly="state != 'pending'"/>
                            <field name="delegatee_id" readonly="state != 'pending'"/>
                            <field name="leave_id" readonly="1"/>
                        </group>
                        <group string="Period">
                            <field name="date_from" readonly="state != 'pending'"/>
                            <field name="date_to" readonly="state != 'pending'"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" placeholder="Additional notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Search view ───────────────────────────────────────────────── -->
    <record id="view_hr_delegation_search" model="ir.ui.view">
        <field name="name">hr.delegation.search</field>
        <field name="model">hr.delegation</field>
        <field name="arch" type="xml">
            <search string="Delegations">
                <field name="delegator_id"/>
                <field name="delegatee_id"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_delegator" string="Delegating Manager"
                            context="{'group_by': 'delegator_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────── -->
    <record id="action_hr_delegation" model="ir.actions.act_window">
        <field name="name">Manager Delegations</field>
        <field name="res_model">hr.delegation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hr_delegation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No delegations found
            </p>
            <p>
                Delegations are created automatically when a manager submits
                a leave request with a delegation user assigned.
            </p>
        </field>
    </record>

    <!-- ── Menu ──────────────────────────────────────────────────────── -->
    <menuitem id="menu_hr_delegation_root"
              name="Delegations"
              parent="hr.menu_hr_root"
              sequence="99"/>

    <menuitem id="menu_hr_delegation_list"
              name="Manager Delegations"
              parent="menu_hr_delegation_root"
              action="action_hr_delegation"
              sequence="1"/>

</odoo>
