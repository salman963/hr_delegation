<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend the hr.leave form to surface delegation info (read-only).   -->
    <!-- The three source fields (delegation_user_id, date_from, date_to)   -->
    <!-- This view simply adds a header button linking to the delegation.    -->

    <record id="view_hr_leave_form_delegation" model="ir.ui.view">
        <field name="name">hr.leave.form.delegation.button</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

             <field name="holiday_status_id" position="after">
                <field name="delegate_employee"/>
            </field>

            <!-- Header button: jump to the delegation record if one exists -->
            <xpath expr="//field[@name='state']" position="before">
                <button type="object"
                        name="action_view_delegation"
                        string="Delegation"
                        class="btn btn-primary"
                        invisible="not delegate_employee">
                </button>
            </xpath>



        </field>
    </record>

</odoo>
